{
  "entities": {
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Represents a user who has subscribed to the newsletter.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "The user's email address."
        },
        "source": {
          "type": "string",
          "description": "Where the user subscribed from."
        },
        "subscribedAt": {
          "type": "timestamp",
          "description": "When the user subscribed."
        }
      },
      "required": ["email", "source", "subscribedAt"]
    }
  },
  "firestore": {
    "newsletter_subscribers/{subscriberId}": {
      "schema": "NewsletterSubscriber",
      "description": "Stores all newsletter subscribers."
    }
  }
}
