rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidNewsletterSubscriber(data) {
      return data.keys().hasAll(['email', 'source', 'subscribedAt']) && 
             data.keys().size() == 3 &&
             data.email is string && data.email.size() <= 200 &&
             data.source is string && data.source.size() <= 50;
    }

    function isValidWizardLead(data) {
      return data.keys().hasAll(["name", "email", "phone", "type", "addons", "domain", "createdAt"]) &&
             data.keys().size() == 7 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() <= 100 &&
             data.type is string &&
             data.addons is list &&
             (data.domain == null || data.domain is string) &&
             data.createdAt == request.time;
    }

    function isValidQuoteSession(data) {
      return (!data.keys().hasAny(['sessionId']) || (data.sessionId is string && data.sessionId.size() <= 100)) &&
             (!data.keys().hasAny(['status']) || (data.status is string && (data.status == 'in_progress' || data.status == 'abandoned' || data.status == 'completed'))) &&
             (!data.keys().hasAny(['currentStep']) || (data.currentStep is number && data.currentStep >= 0 && data.currentStep <= 10)) &&
             (!data.keys().hasAny(['sector']) || (data.sector == null || (data.sector is string && data.sector.size() <= 100))) &&
             (!data.keys().hasAny(['businessType']) || (data.businessType == null || (data.businessType is string && data.businessType.size() <= 100))) &&
             (!data.keys().hasAny(['webType']) || (data.webType == null || (data.webType is string && data.webType.size() <= 100))) &&
             (!data.keys().hasAny(['addons']) || data.addons is list) &&
             (!data.keys().hasAny(['estimatedPrice']) || (data.estimatedPrice is number && data.estimatedPrice >= 0)) &&
             (!data.keys().hasAny(['email']) || (data.email is string && data.email.size() <= 200)) &&
             (!data.keys().hasAny(['createdAt']) || data.createdAt == request.time || (resource != null && data.createdAt == resource.data.createdAt)) &&
             (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time);
    }

    function isValidArchivedTask(data) {
      return data.keys().hasAll(['id', 'projectId', 'title', 'description', 'status', 'archived']) &&
             data.id is string && data.id.size() <= 128 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.status is string && (data.status == 'approved' || data.status == 'rejected' || data.status == 'pending') &&
             data.archived == true;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow create: if isValidId(subscriberId) &&
                    isValidNewsletterSubscriber(request.resource.data) &&
                    request.resource.data.subscribedAt == request.time;
    }

    match /wizardLeads/{leadId} {
      allow create: if isValidId(leadId) &&
                    isValidWizardLead(request.resource.data);
    }

    match /quoteSessions/{sessionId} {
      allow get: if isValidId(sessionId);
      allow create: if isValidId(sessionId) &&
                    request.resource.data.keys().hasAll(['sessionId', 'status', 'createdAt', 'updatedAt']) &&
                    request.resource.data.keys().size() == 4 &&
                    request.resource.data.sessionId == sessionId &&
                    isValidQuoteSession(request.resource.data);
      allow update: if isValidId(sessionId) &&
                    isValidQuoteSession(request.resource.data);
    }

    match /archived_tasks/{taskId} {
      allow read, write: if request.auth != null && (
        // Admin can read/write any archived task (assuming role is in custom claim, or fetched from /users)
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        // Client can read/write their own archived tasks
        // This requires that the archived task document *itself* stores the clientUserId,
        // OR we can fetch the project to verify client ownership.
        // Assuming 'projectId' is stored in the archived task, and project has 'clientUserId'
        existsAfter(get(/databases/$(database)/documents/projects/$(resource.data.projectId))) &&
        get(/databases/$(database)/documents/projects/$(resource.data.projectId)).data.clientUserId == request.auth.uid
      );
    }
  }
}
