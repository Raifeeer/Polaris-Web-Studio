rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidNewsletterSubscriber(data) {
      return data.keys().hasAll(['email', 'source', 'subscribedAt']) && 
             data.keys().size() == 3 &&
             data.email is string && data.email.size() <= 200 &&
             data.source is string && data.source.size() <= 50;
    }

    match /newsletter_subscribers/{subscriberId} {
      // Allow any user (even unauthenticated) to subscribe via the form.
      // We only allow create. We don't allow read, update, or delete.
      allow create: if isValidNewsletterSubscriber(request.resource.data) &&
                    request.resource.data.subscribedAt == request.time;
    }
  }
}
